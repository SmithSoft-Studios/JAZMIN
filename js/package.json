{
  "name": "@smithsoft-studios/jazmin",
  "version": "1.7.4",
  "description": "JAZMIN (Javascript Secure Zipped Multi Index Notation) - compact, indexed, optionally encrypted tabular file format with JSON/CSV/XML conversion.",
  "keywords": [
    "jazmin",
    "file-format",
    "tabular",
    "columnar",
    "index",
    "encryption",
    "json",
    "csv"
  ],
  "homepage": "https://github.com/SmithSoft-Studios/JAZMIN#readme",
  "bugs": "https://github.com/SmithSoft-Studios/JAZMIN/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SmithSoft-Studios/JAZMIN.git",
    "directory": "js"
  },
  "author": "SmithSoft Pty Ltd",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "jazmin": "bin/jazmin.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./browser": "./browser/jazmin-browser.js",
    "./browser/core": "./browser/jazmin-browser-core.js",
    "./browser/shapes": "./browser/jazmin-browser-shapes.js",
    "./browser/writer": "./browser/jazmin-browser-writer.js",
    "./browser/queries": "./browser/jazmin-browser-queries.js"
  },
  "files": [
    "src",
    "browser",
    "bin",
    "viewer/index.html",
    "viewer/viewer.js",
    "viewer/viewer.css",
    "viewer/sandbox.js",
    "viewer/sw.js",
    "viewer/manifest.webmanifest",
    "viewer/icon-32.png",
    "viewer/icon-192.png",
    "viewer/icon-512.png"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p examples/typescript",
    "bench": "node bench/benchmark.js",
    "bench:proposals": "node bench/proposals.mjs",
    "bench:filing": "node bench/filing.mjs",
    "bench:storage": "node bench/storage.mjs",
    "bench:layout": "node bench/layout.mjs",
    "bench:links": "node bench/links.mjs",
    "bench:viewer": "node bench/viewer-disk.mjs",
    "fixtures": "node scripts/make-fixtures.js",
    "viewer": "node viewer/serve.mjs",
    "test:viewer": "node scripts/viewer-e2e.mjs"
  },
  "license": "MIT",
  "types": "src/index.d.ts",
  "devDependencies": {
    "@types/node": "^22.20.4",
    "playwright-core": "^1.63.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.9.3"
  }
}
