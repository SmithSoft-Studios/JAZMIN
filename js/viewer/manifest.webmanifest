{
  "name": "JAZMIN viewer",
  "short_name": "JAZMIN",
  "description": "Open JAZMIN (.jzm) files: data, embedded documents and files. Nothing is uploaded.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f5f7",
  "theme_color": "#1f5eff",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "file_handlers": [{ "action": "./", "accept": { "application/x-jazmin": [".jzm"] } }]
}
