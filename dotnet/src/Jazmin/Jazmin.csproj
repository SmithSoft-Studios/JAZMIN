<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <RootNamespace>Jazmin</RootNamespace>
    <PackageId>Jazmin</PackageId>
    <Version>1.1.0</Version>
    <Description>JAZMIN (Javascript Secure Zipped Multi Index Notation): compact, indexed, optionally encrypted tabular file format with JSON/CSV/XML conversion and a Newtonsoft-style serializer API.</Description>
    <Authors>SmithSoft Pty Ltd</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SmithSoft-Studios/JAZMIN</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SmithSoft-Studios/JAZMIN</RepositoryUrl>
    <PackageTags>jazmin;file-format;tabular;columnar;index;encryption;json;csv;serializer</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jazmin.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
